# ── Local AI LLM (WAJIB dikonfigurasi via env - development_rules.md) ──────
LLM_PROVIDER=ollama                # ollama | openai_compatible
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:latest
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
# LLM_SYSTEM_PROMPT=Anda adalah PsychoBot, ...

# ── Firebase (opsional; kosong = mode lokal SQLite + token dev-) ───────────
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

# ── SIAGA Gateway ───────────────────────────────────────────────────────────
SIAGA_CORS_ORIGINS=http://localhost:3000
SIAGA_RATE_LIMIT=100
SIAGA_RATE_WINDOW_S=60
SIAGA_PAYLOAD_CAP_KB=32

# ── SIAGA Guardrail tuning (default v0 terkalibrasi) ────────────────────────
SIAGA_THRESHOLD_PROBE=0.60
SIAGA_THRESHOLD_BLOCK=0.80
SIAGA_TTL_HOURS=24
SIAGA_TRAJ_SIM=0.20
